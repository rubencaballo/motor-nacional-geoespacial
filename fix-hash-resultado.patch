--- a/modelos/predio.py
+++ b/modelos/predio.py
@@ -74,6 +74,7 @@ class PredioNacional:
     score_prioridad: float = 0.0
     hash_geo: str = ""
     checksum_integridad: str = ""
+    hash_resultado: str = ""
     motivos_incompleto: List[str] = field(default_factory=list)
     version: str = VERSION
     fecha: str = ""
@@ -201,8 +202,22 @@ class PredioNacional:
     def generar_auditoria(self):
         geom_str = json.dumps(self.geometria, sort_keys=True)
         self.hash_geo = hashlib.sha256(geom_str.encode()).hexdigest()[:16]
+
+        # checksum_integridad: incluye VERSION a propósito. Es el checksum de
+        # AUDITORÍA/PRODUCCIÓN -- permite saber, mirando un registro guardado
+        # hace meses, con qué versión exacta del motor se generó. NO debe
+        # usarse para comparar equivalencia lógica entre versiones distintas
+        # del motor, porque cambia aunque el resultado sea el mismo.
         payload = f"{self.id_predio}{self.hash_geo}{self.B_treecover:.2f}{self.D_ha_validada:.4f}{self.color}{VERSION}"
         self.checksum_integridad = hashlib.sha256(payload.encode()).hexdigest()[:16]
+
+        # hash_resultado: mismo payload SIN VERSION. Este es el que se debe
+        # usar en tests de regresión / comparación monolítico vs modular,
+        # porque solo cambia si cambia el resultado real (color, hectáreas
+        # validadas, etc.), no si cambia el string de versión del motor.
+        payload_contenido = f"{self.id_predio}{self.hash_geo}{self.B_treecover:.2f}{self.D_ha_validada:.4f}{self.color}"
+        self.hash_resultado = hashlib.sha256(payload_contenido.encode()).hexdigest()[:16]
+
         self.fecha = datetime.now(timezone.utc).isoformat()
 
 
